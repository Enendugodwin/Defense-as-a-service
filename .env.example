# Copy to .env locally and set every blank value to a unique, strong secret.
# REGISTRATION_TOKEN and ADMIN_API_KEY must be at least 32 characters.
# REDIS_PASSWORD and POSTGRES_PASSWORD must be at least 16 characters.
REDIS_PASSWORD=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
REGISTRATION_TOKEN=
ADMIN_API_KEY=
REMOTE_COMMANDS_ENABLED=true
ALLOW_INSECURE_HTTP=false
SESSION_IDLE_TIMEOUT_SECONDS=900
API_DOCS_ENABLED=false

# Keep host ports on loopback unless protected TLS/firewall access is configured.
INGEST_BIND_ADDRESS=127.0.0.1
INGEST_PORT=8000
DASHBOARDS_BIND_ADDRESS=127.0.0.1
DASHBOARDS_PORT=5601
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
SYSLOG_BIND_ADDRESS=127.0.0.1
SYSLOG_HOST_PORT=514
C2_WEB_PORT=8081
OPENSEARCH_VERIFY_CERTS=false