# Copy to .env locally and fill every blank value with a unique secret.
# Never commit your populated .env file.
REDIS_PASSWORD=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
REGISTRATION_TOKEN=
ADMIN_API_KEY=

# Keep published services bound to loopback unless you have designed and secured remote access.
INGEST_BIND_ADDRESS=127.0.0.1
INGEST_PORT=8000
DASHBOARDS_BIND_ADDRESS=127.0.0.1
DASHBOARDS_PORT=5601
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
SYSLOG_BIND_ADDRESS=127.0.0.1
SYSLOG_HOST_PORT=514
OPENSEARCH_VERIFY_CERTS=false
